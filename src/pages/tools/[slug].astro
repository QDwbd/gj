---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { tools } from '../../data/tools';
export function getStaticPaths() {
  return tools.map(tool => ({ params: { slug: tool.slug }, props: { tool } }));
}
const { tool } = Astro.props;
---
<BaseLayout title={`${tool.name} - 在线工具箱`} description={tool.description}>
  <div class="tool-page">
    <div class="breadcrumbs"><a href="/">首页</a><span>/</span><a href="/#all-tools">全部工具</a><span>/</span><span>{tool.name}</span></div>
    <section class="tool-intro">
      <a class="back-link" href="/">← 返回工具箱</a>
      <span class="eyebrow">{tool.category}</span>
      <h1>{tool.name}</h1>
      <p>{tool.description}</p>
    </section>

    {tool.operation === 'image-editor' && <section id="image-workbench" class="workbench image-workbench" style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>图片编辑工作台</strong></div><span class="privacy-label">图片在本地浏览器处理</span></div>
      <label class="field-label" for="image-file">选择图片（PNG / JPEG / WebP，最大 25 MB）</label>
      <input id="image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:14px;margin:18px 0">
        <label>亮度 <input id="image-brightness" type="range" min="0" max="200" value="100" /></label>
        <label>对比度 <input id="image-contrast" type="range" min="0" max="200" value="100" /></label>
        <label>旋转 <select id="image-rotation"><option value="0">0°</option><option value="90">90°</option><option value="180">180°</option><option value="270">270°</option></select></label>
        <label>像素化强度 <input id="image-pixelate" type="range" min="1" max="40" value="1" /></label>
        <label>裁剪宽度（中心裁剪 %） <input id="image-crop-width" type="range" min="10" max="100" value="100" /></label>
        <label>裁剪高度（中心裁剪 %） <input id="image-crop-height" type="range" min="10" max="100" value="100" /></label>
        <label>水印文字 <input id="image-watermark" type="text" maxlength="120" placeholder="可选：输入水印文字" /></label>
        <label>导出格式 <select id="image-format"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option></select></label>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:16px;margin-bottom:18px">
        <label><input id="image-flip-x" type="checkbox" /> 水平翻转</label>
        <label><input id="image-flip-y" type="checkbox" /> 垂直翻转</label>
        <label><input id="image-grayscale" type="checkbox" /> 灰度</label>
        <label><input id="image-sepia" type="checkbox" /> 复古滤镜</label>
      </div>
      <div style="background:var(--surface-2,#f4f5f7);padding:12px;border-radius:12px;overflow:auto;text-align:center">
        <canvas id="image-canvas" hidden style="max-width:100%;height:auto"></canvas>
        <p id="image-status" role="status">请先选择一张图片。处理过程不会主动上传图片。</p>
      </div>
      <div class="action-row" style="margin-top:16px">
        <button id="image-reset" class="secondary-button" type="button">重置编辑</button>
        <button id="image-download" class="primary-button" type="button" disabled>导出图片</button>
      </div>
      <p class="muted">说明：裁剪采用居中裁剪；GIF 等动图会按浏览器解码后的静态帧处理。复杂透明图像导出为 JPEG 时会由浏览器按其默认方式处理透明区域。</p>
    </section>}


    {['image-to-base64', 'base64-to-image', 'svg-to-png'].includes(tool.operation) && <section id="media-workbench" class="workbench media-workbench" data-media-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>图片转换工作台</strong></div><span class="privacy-label">本地浏览器处理</span></div>
      {tool.operation === 'image-to-base64' && <div>
        <label class="field-label" for="media-image-file">选择图片（PNG / JPEG / WebP / GIF / AVIF，最大 20 MB）</label>
        <input id="media-image-file" type="file" accept="image/png,image/jpeg,image/webp,image/gif,image/avif" />
        <div class="action-row"><button id="media-convert" class="primary-button" type="button">转换为 Base64</button><button id="media-clear" class="secondary-button" type="button">清空</button></div>
        <label class="field-label" for="media-base64-output">Data URL 结果</label><textarea id="media-base64-output" rows="8" readonly spellcheck="false"></textarea>
        <button id="media-copy" class="secondary-button" type="button">复制结果</button>
      </div>}
      {tool.operation === 'base64-to-image' && <div>
        <label class="field-label" for="media-base64-input">Base64 或 Data URL</label><textarea id="media-base64-input" rows="7" spellcheck="false" placeholder="粘贴 data:image/png;base64,... 或纯 Base64"></textarea>
        <label class="field-label" for="media-mime">纯 Base64 的图片格式</label><select id="media-mime"><option value="image/png">PNG</option><option value="image/jpeg">JPEG</option><option value="image/webp">WebP</option><option value="image/gif">GIF</option><option value="image/avif">AVIF</option></select>
        <div class="action-row"><button id="media-convert" class="primary-button" type="button">解码预览</button><button id="media-download" class="secondary-button" type="button" disabled>下载图片</button><button id="media-clear" class="secondary-button" type="button">清空</button></div>
        <img id="media-image-preview" alt="Base64 解码后的图片预览" style="display:block;max-width:100%;max-height:600px;margin:16px auto" />
      </div>}
      {tool.operation === 'svg-to-png' && <div>
        <label class="field-label" for="media-svg-input">SVG 源码</label><textarea id="media-svg-input" rows="9" spellcheck="false" placeholder="<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;300&quot; height=&quot;100&quot;><rect width=&quot;300&quot; height=&quot;100&quot; fill=&quot;#4263eb&quot;/></svg>"></textarea>
        <div style="display:flex;flex-wrap:wrap;gap:16px;margin:12px 0"><label>宽度 px <input id="media-svg-width" type="number" min="1" max="4096" value="600" /></label><label>高度 px <input id="media-svg-height" type="number" min="1" max="4096" value="300" /></label></div>
        <div class="action-row"><button id="media-convert" class="primary-button" type="button">渲染 PNG</button><button id="media-download" class="secondary-button" type="button" disabled>下载 PNG</button><button id="media-clear" class="secondary-button" type="button">清空</button></div>
        <canvas id="media-svg-canvas" hidden style="max-width:100%;height:auto;margin:16px auto"></canvas>
      </div>}
      <p id="media-status" role="status">选择文件或输入内容开始转换。数据不会主动上传到服务器。</p>
    </section>}


    {['qr-generator', 'barcode-generator'].includes(tool.operation) && <section id="barcode-workbench" class="workbench barcode-workbench" data-barcode-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>{tool.operation === 'qr-generator' ? '二维码生成工作台' : '条码生成工作台'}</strong></div><span class="privacy-label">浏览器本地生成</span></div>
      {tool.operation === 'barcode-generator' && <label class="field-label" for="barcode-type">条码标准</label>}
      {tool.operation === 'barcode-generator' && <select id="barcode-type"><option value="code128">Code 128（通用）</option><option value="code39">Code 39</option><option value="ean13">EAN-13（13 位商品码）</option><option value="ean8">EAN-8（8 位商品码）</option><option value="upca">UPC-A（12 位商品码）</option><option value="itf14">ITF-14（14 位物流码）</option></select>}
      <label class="field-label" for="barcode-text">编码内容</label>
      <textarea id="barcode-text" rows="4" spellcheck="false" placeholder="输入网址、文本或符合所选标准的条码数字"></textarea>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:16px 0">
        <label>缩放倍率 <input id="barcode-scale" type="number" min="1" max="10" value="3" /></label>
        <label>边距 <input id="barcode-padding" type="number" min="0" max="30" value="10" /></label>
        {tool.operation === 'barcode-generator' && <label>条码高度（毫米） <input id="barcode-height" type="number" min="5" max="100" value="15" /></label>}
        <label>前景色 <input id="barcode-foreground" type="color" value="#000000" /></label>
        <label>背景色 <input id="barcode-background" type="color" value="#ffffff" /></label>
      </div>
      {tool.operation === 'barcode-generator' && <label><input id="barcode-human-readable" type="checkbox" checked /> 显示可读数字</label>}
      <div class="action-row" style="margin-top:16px"><button id="barcode-generate" class="primary-button" type="button">生成</button><button id="barcode-download" class="secondary-button" type="button" disabled>下载 PNG</button><button id="barcode-reset" class="secondary-button" type="button">重置</button></div>
      <div style="margin-top:18px;overflow:auto;text-align:center"><canvas id="barcode-canvas" hidden style="max-width:100%;height:auto"></canvas></div>
      <p id="barcode-status" role="status">生成在本地完成；条码数字格式会按所选标准校验。</p>
    </section>}


    {['pdf-page-editor', 'pdf-merge'].includes(tool.operation) && <section id="pdf-workbench" class="workbench pdf-workbench" data-pdf-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>{tool.operation === 'pdf-page-editor' ? 'PDF 页面整理工作台' : 'PDF 合并工作台'}</strong></div><span class="privacy-label">文件在浏览器本地处理</span></div>
      {tool.operation === 'pdf-page-editor' && <div>
        <label class="field-label" for="pdf-file">选择 PDF 文件（最大 80 MB）</label><input id="pdf-file" type="file" accept="application/pdf,.pdf" />
        <label class="field-label" for="pdf-page-order">输出页码顺序 / 保留页码</label><input id="pdf-page-order" type="text" placeholder="留空保留全部；例如 3,1,2-4 表示按该顺序输出" />
        <label class="field-label" for="pdf-rotation">输出页面旋转角度</label><select id="pdf-rotation"><option value="0">不旋转</option><option value="90">顺时针 90°</option><option value="180">180°</option><option value="270">顺时针 270°</option></select>
        <p class="muted">页码从 1 开始；用逗号分隔单页或范围。未列出的页会被删除，重复页码会复制对应页面。</p>
      </div>}
      {tool.operation === 'pdf-merge' && <div>
        <label class="field-label" for="pdf-files">选择多个 PDF 文件（2–20 个，总计最大 100 MB）</label><input id="pdf-files" type="file" accept="application/pdf,.pdf" multiple />
        <p class="muted">合并顺序与文件选择列表顺序一致。加密或损坏的 PDF 可能无法处理。</p>
      </div>}
      <div class="action-row" style="margin-top:16px"><button id="pdf-process" class="primary-button" type="button">{tool.operation === 'pdf-page-editor' ? '应用页面设置' : '合并 PDF'}</button><button id="pdf-download" class="secondary-button" type="button" disabled>下载 PDF</button><button id="pdf-reset" class="secondary-button" type="button">重置</button></div>
      <p id="pdf-status" role="status">请选择 PDF 文件开始。文件内容不会主动上传到服务器。</p>
    </section>}


    {tool.operation === 'pdf-to-images' && <section id="pdf-image-workbench" class="workbench pdf-image-workbench" data-pdf-operation="pdf-to-images" style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>PDF 转图片工作台</strong></div><span class="privacy-label">浏览器本地渲染</span></div>
      <label class="field-label" for="pdf-image-file">选择 PDF 文件（最大 80 MB）</label><input id="pdf-image-file" type="file" accept="application/pdf,.pdf" />
      <label class="field-label" for="pdf-image-pages">要导出的页码</label><input id="pdf-image-pages" type="text" placeholder="留空导出全部；例如 1,3-5" />
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:16px 0">
        <label>缩放比例 <select id="pdf-image-scale"><option value="0.5">0.5×（较小）</option><option value="1">1×</option><option value="1.5" selected>1.5×（推荐）</option><option value="2">2×（高清）</option><option value="3">3×（超高清）</option></select></label>
        <label>背景颜色 <select id="pdf-image-background"><option value="#ffffff">白色</option><option value="#f5f5f5">浅灰</option><option value="#000000">黑色</option></select></label>
      </div>
      <p class="muted">每次最多导出 50 页；单页最多 1600 万像素。所有 PNG 将打包为一个 ZIP 文件。</p>
      <div class="action-row"><button id="pdf-image-render" class="primary-button" type="button">渲染页面</button><button id="pdf-image-download" class="secondary-button" type="button" disabled>下载 ZIP</button><button id="pdf-image-reset" class="secondary-button" type="button">重置</button></div>
      <p id="pdf-image-status" role="status">请选择 PDF 文件开始转换；文件不会主动上传。</p>
      <div id="pdf-image-preview" style="margin-top:16px"></div>
    </section>}


    {['audio-player', 'video-speed'].includes(tool.operation) && <section id="playback-workbench" class="workbench playback-workbench" data-playback-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>{tool.operation === 'audio-player' ? '本地音频播放器' : '视频变速工作台'}</strong></div><span class="privacy-label">本地播放，不上传文件</span></div>
      <label class="field-label" for="playback-file">{tool.operation === 'audio-player' ? '选择音频文件（最大 200 MB）' : '选择视频文件（最大 200 MB）'}</label>
      <input id="playback-file" type="file" accept={tool.operation === 'audio-player' ? 'audio/*' : 'video/*'} />
      <label class="field-label" for="playback-speed">播放速度</label>
      <select id="playback-speed"><option value="0.5">0.5×</option><option value="0.75">0.75×</option><option value="1" selected>1×</option><option value="1.25">1.25×</option><option value="1.5">1.5×</option><option value="2">2×</option></select>
      {tool.operation === 'audio-player' && <audio id="playback-player" controls style="display:block;width:100%;margin:16px 0"></audio>}
      {tool.operation === 'video-speed' && <video id="playback-player" controls playsinline style="display:block;width:100%;max-height:560px;background:#111;margin:16px 0"></video>}
      <p id="playback-status" role="status">请选择本地媒体文件开始播放。</p>
    </section>}
    {tool.operation === 'screen-recorder' && <section id="screen-recorder-workbench" class="workbench screen-recorder-workbench" style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>屏幕录制工作台</strong></div><span class="privacy-label">需你主动授权共享屏幕</span></div>
      <label><input id="record-audio" type="checkbox" /> 同时录制系统音频（取决于浏览器和共享选项）</label>
      <p class="muted">点击开始后，在浏览器弹出的系统窗口中选择要共享的屏幕、窗口或标签页。录制会保存在本地并以 WebM 格式下载。</p>
      <div class="action-row"><button id="record-start" class="primary-button" type="button">开始录制</button><button id="record-stop" class="secondary-button" type="button" disabled>停止并下载</button></div>
      <p id="record-status" role="status">尚未开始录制。浏览器会在授权前询问你要共享的内容。</p>
    </section>}


    {tool.operation === 'sqlite-browser' && <section id="sqlite-workbench" class="workbench sqlite-workbench" style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>SQLite 数据库工作台</strong></div><span class="privacy-label">数据库在浏览器本地处理</span></div>
      <label class="field-label" for="sqlite-file">选择 SQLite 数据库（最大 50 MB）</label><input id="sqlite-file" type="file" accept=".db,.sqlite,.sqlite3,application/x-sqlite3,application/vnd.sqlite3" />
      <label class="field-label" for="sqlite-query">SQL 语句</label><textarea id="sqlite-query" rows="8" spellcheck="false" placeholder="打开数据库后输入 SQL，例如 SELECT name FROM sqlite_master;"></textarea>
      <div class="action-row"><button id="sqlite-run" class="primary-button" type="button" disabled>执行 SQL</button><button id="sqlite-export" class="secondary-button" type="button" disabled>导出数据库</button><button id="sqlite-reset" class="secondary-button" type="button">关闭 / 重置</button></div>
      <p class="muted">支持 SELECT、INSERT、UPDATE、DELETE、CREATE TABLE 等 SQLite 语句。结果表格最多显示每个结果集前 500 行；修改只保存在当前页面内存，需点击“导出数据库”下载。</p>
      <p id="sqlite-status" role="status">请选择本地数据库文件开始。</p>
      <div id="sqlite-results" style="margin-top:16px"></div>
    </section>}


    {['excel-to-json', 'excel-to-html'].includes(tool.operation) && <section id="excel-workbench" class="workbench excel-workbench" data-excel-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>{tool.operation === 'excel-to-json' ? 'Excel 转 JSON 工作台' : 'Excel 转 HTML 工作台'}</strong></div><span class="privacy-label">本地浏览器处理</span></div>
      <label class="field-label" for="excel-file">选择 XLSX 文件（最大 50 MB；不支持旧版 XLS）</label><input id="excel-file" type="file" accept=".xlsx,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" />
      <label class="field-label" for="excel-sheet">工作表</label><select id="excel-sheet"></select>
      <div class="action-row"><button id="excel-convert" class="primary-button" type="button">转换</button><button id="excel-copy" class="secondary-button" type="button">复制结果</button></div>
      <label class="field-label" for="excel-result">转换结果</label><textarea id="excel-result" rows="12" readonly spellcheck="false" placeholder="转换结果会显示在这里…"></textarea>
      <p id="excel-status" role="status">请选择 XLSX 文件开始。</p>
    </section>}
    {tool.operation === 'json-to-excel' && <section id="excel-workbench" class="workbench excel-workbench" data-excel-operation={tool.operation} style="display:block">
      <div class="workbench-head"><div><span class="status-dot"></span><strong>JSON 转 Excel 工作台</strong></div><span class="privacy-label">本地生成文件</span></div>
      <label class="field-label" for="excel-json">JSON 对象数组</label><textarea id="excel-json" rows="10" spellcheck="false" placeholder="[{&quot;name&quot;:&quot;Ada&quot;,&quot;age&quot;:30}]"></textarea>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin:16px 0"><label>工作表名称 <input id="excel-sheet-name" type="text" maxlength="31" value="Sheet1" /></label><label>文件名 <input id="excel-filename" type="text" value="export.xlsx" /></label></div>
      <div class="action-row"><button id="excel-export" class="primary-button" type="button">生成并下载 XLSX</button></div>
      <p id="excel-status" role="status">输入 JSON 对象数组即可生成工作簿。</p>
    </section>}


    {tool.operation === 'image-lab' && <section id="image-lab-workbench" class="workbench image-lab-workbench" data-image-slug={tool.slug} style="display:block">
      <div class="image-lab-top">
        <div><span class="status-dot"></span><strong>专业图片处理台</strong><span class="image-lab-local">100% 浏览器本地处理</span></div>
        <span class="image-lab-hint">支持 PNG、JPG、WebP、GIF、AVIF 等常见图片</span>
      </div>
      <div class="image-lab-layout">
        <aside class="image-lab-sidebar">
          <div class="image-lab-section-title"><span>01</span><div><strong>导入图片</strong><small>单张或批量选择</small></div></div>
          <label class="image-dropzone" id="lab-dropzone" for="lab-files">
            <span class="image-drop-icon">＋</span><strong>点击选择或拖放图片</strong><small>最多 100 张 · 单张建议不超过 25 MB</small>
            <input id="lab-files" type="file" accept="image/*" multiple />
          </label>
          <div id="lab-file-list" class="image-file-list"><span class="image-empty">尚未添加图片</span></div>
          <div class="image-lab-divider"></div>
          <div class="image-lab-section-title"><span>02</span><div><strong>调整参数</strong><small>根据当前工具显示相关选项</small></div></div>
          <div class="image-settings">
            <label data-setting="amount"><span id="lab-amount-label">处理强度</span><input id="lab-amount" type="range" min="0" max="200" value="100" /><output id="lab-amount-value">100</output></label>
            <label data-setting="threshold"><span>背景颜色容差</span><output id="lab-threshold-value">35</output><input id="lab-threshold" type="range" min="0" max="255" value="35" /></label>
             <label data-setting="feather"><span>边缘柔化</span><output id="lab-feather-value">24</output><input id="lab-feather" type="range" min="0" max="100" value="24" /></label>
            <label data-setting="color"><span id="lab-color-label">目标颜色</span><input id="lab-color" type="color" value="#ffffff" /></label>
            <label data-setting="color2">替换颜色<input id="lab-color2" type="color" value="#4263eb" /></label>
            <label data-setting="angle">旋转角度<input id="lab-angle" type="number" min="-360" max="360" value="90" /></label>
            <label data-setting="radius"><span id="lab-radius-label">圆角半径</span><input id="lab-radius" type="number" min="0" max="2000" value="40" /></label>
            <label data-setting="text">水印文字<input id="lab-text" type="text" maxlength="80" value="©" /></label>
            <label data-setting="count">复制数量<input id="lab-count" type="number" min="1" max="10" value="2" /></label>
            <div class="image-dimensions" data-setting="dimensions"><label>输出宽度（px）<input id="lab-width" type="number" min="1" max="8192" value="1200" /></label><label>输出高度（px）<input id="lab-height" type="number" min="1" max="8192" value="800" /></label></div>
            <div class="image-dimensions" data-setting="crop-region" hidden><label>裁切起点 X（%）<input id="lab-crop-x" type="number" min="0" max="99" value="0" /></label><label>裁切起点 Y（%）<input id="lab-crop-y" type="number" min="0" max="99" value="0" /></label><label>裁切宽度（%）<input id="lab-crop-width" type="number" min="1" max="100" value="100" /></label><label>裁切高度（%）<input id="lab-crop-height" type="number" min="1" max="100" value="100" /></label></div>
            <label data-setting="ratio-lock" hidden class="image-ratio-lock"><input id="lab-ratio-lock" type="checkbox" checked /> 锁定原图宽高比例</label>
            <label data-setting="fit-mode" hidden>尺寸适配方式<select id="lab-fit-mode"><option value="contain">完整显示（留白）</option><option value="cover">填满尺寸（自动裁边）</option><option value="stretch">拉伸至指定尺寸</option></select></label>
            <div class="image-source-info" id="lab-source-info" data-setting="source-info" hidden>原图尺寸：等待读取</div>
            <label data-setting="mode">算法 / 排列方向<select id="lab-mode"><option value="709">BT.709 灰度 / 横向</option><option value="601">BT.601 灰度</option><option value="average">平均灰度</option><option value="vertical">纵向排列</option></select></label>
            <label data-setting="format">导出格式<select id="lab-format"><option value="image/png">PNG · 无损</option><option value="image/jpeg">JPEG · 通用</option><option value="image/webp">WebP · 高压缩</option></select></label>
          </div>
          <div class="image-lab-actions"><button id="lab-process" class="primary-button" type="button">应用处理 <span>→</span></button><button id="lab-reset" class="secondary-button" type="button">重置</button></div>
          <p class="image-privacy-note">🔒 图片只在当前设备处理，不会主动上传。大图会限制在约 1600 万像素以内以避免浏览器内存不足。</p>
        </aside>
        <div class="image-lab-workspace">
          <div class="image-preview-head"><div><strong>处理结果</strong><span id="lab-preview-count">等待导入图片</span></div><button id="lab-download" class="primary-button" type="button" disabled>下载首张结果</button></div>
          <div id="lab-status" class="image-lab-status" role="status">先添加图片，再调整参数并点击“应用处理”。</div>
          <div id="lab-preview" class="image-result-grid"><div class="image-preview-placeholder"><span>▧</span><strong>结果列表</strong><small>处理完成后显示尺寸、文件大小和逐张下载入口</small></div></div>
          <canvas id="lab-canvas" hidden></canvas>
          <div class="image-output-note">导出提示：透明背景建议选择 PNG；照片可选择 JPEG 或 WebP。批量文件可逐张下载，避免浏览器拦截多个下载。</div>
        </div>
      </div>
    </section>}

    <section class="workbench" style={["image-editor", "image-to-base64", "base64-to-image", "svg-to-png", "qr-generator", "barcode-generator", "pdf-page-editor", "pdf-merge", "pdf-to-images", "audio-player", "video-speed", "screen-recorder", "sqlite-browser", "excel-to-json", "excel-to-html", "json-to-excel", "image-lab"].includes(tool.operation) ? "display:none" : undefined} data-operation={tool.operation} data-tool-name={tool.name}>
      <div class="workbench-head"><div><span class="status-dot"></span><strong>在线工作台</strong></div><span class="privacy-label">在浏览器中处理</span></div>
      <div id="tool-controls" class="tool-controls"></div>
      <label class="field-label" for="tool-input">输入内容</label>
      <textarea id="tool-input" rows="9" spellcheck="false" placeholder="在这里输入或粘贴内容…"></textarea>
      <div class="action-row"><button id="run-tool" class="primary-button">运行工具 <span>→</span></button><button id="clear-tool" class="secondary-button">清空</button><span id="tool-status" role="status"></span></div>
      <label class="field-label output-label" for="tool-output">处理结果</label>
      <textarea id="tool-output" rows="9" readonly spellcheck="false" placeholder="结果将显示在这里…"></textarea>
      <div class="action-row bottom-actions"><span id="output-meta">结果仅在本页显示</span><button id="copy-tool" class="secondary-button">复制结果</button></div>
    </section>
    <section class="info-panel"><h2>使用说明</h2><p>{tool.description} 本工具优先在你的浏览器本地处理输入内容。请注意，格式转换工具对复杂或非标准输入可能需要手动检查结果。</p><p class="muted">隐私提示：此工具页面不主动上传输入文本。请不要将密码、私钥或其他敏感数据粘贴到不可信的网页中。</p></section>
    <a class="more-link" href="/">← 浏览更多在线工具</a>
  </div>
  <script type="module" src="/scripts/tool-engine.js"></script>
  <script type="module" src="/scripts/image-editor.js"></script>
  <script type="module" src="/scripts/image-lab.js"></script>
  <script type="module" src="/scripts/media-tools.js"></script>
  <script src="../../scripts/barcode-tools.js"></script>
  <script src="../../scripts/pdf-tools.js"></script>
  <script src="../../scripts/pdf-render.js"></script>
  <script src="../../scripts/media-playback.js"></script>
  <script src="../../scripts/sqlite-browser.js"></script>
  <script src="../../scripts/excel-tools.js"></script>
</BaseLayout>