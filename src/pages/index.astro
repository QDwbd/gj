---
import BaseLayout from '../layouts/BaseLayout.astro';
import { tools } from '../data/tools';
const categories = [...new Set(tools.map(t => t.category))];
const featuredSlugs = ['json-format','json-validate','base64-encode','url-encode','text-count','text-replace','csv-to-json','json-to-csv','calculator','timestamp-date','color-contrast','css-gradient'];
const featured = featuredSlugs.map(slug => tools.find(tool => tool.slug === slug)).filter(Boolean);
---
<BaseLayout title="工具箱 — 免费在线工具集合" description="集合文本、开发、编码、时间、数学、颜色等实用在线工具。">
  <section class="hero">
    <div class="hero-badge"><span class="pulse"></span> 简洁 · 免费 · 即开即用</div>
    <h1>让工具，<span>触手可及。</span></h1>
    <p>一站式在线工具集合。无需安装软件，打开浏览器即可使用。</p>
    <label class="search-wrap"><span>⌕</span><input id="tool-search" type="search" placeholder="搜索工具，例如 JSON、时间戳、Base64…" autocomplete="off" /><kbd>搜索</kbd></label>
    <div class="hero-stats"><span><b>{tools.length}+</b> 实用工具</span><span><b>{categories.length}</b> 个分类</span><span><b>0</b> 次安装</span></div>
  </section>
  <section class="section" id="featured-tools">
    <div class="section-heading"><div><span class="eyebrow">QUICK ACCESS</span><h2>常用工具</h2></div><span class="muted">优先展示最常用的实用功能</span></div>
    <div class="tool-grid">
      {featured.map(t => <a class="tool-card" data-search={`${t.name} ${t.description} ${t.category} ${t.slug}`} href={`/tools/${t.slug}/`}><span class="tool-symbol">{t.name.slice(0,1)}</span><span class="tool-copy"><strong>{t.name}</strong><small>{t.description}</small></span><span class="card-arrow">→</span></a>)}
    </div>
  </section>
  <section class="section" id="categories">
    <div class="section-heading"><div><span class="eyebrow">BROWSE BY CATEGORY</span><h2>按分类探索</h2></div><span class="muted">找到合适的工具，从这里开始</span></div>
    <div class="category-grid">
      {categories.map((category, i) => <a class="category-card" href={`/#cat-${i}`}><span class="category-icon">{['Aa','{}','⇄','◷','∑','◉','✳','⌘','▦','✦'][i % 10]}</span><span><strong>{category}</strong><small>{tools.filter(t => t.category === category).length} 个工具</small></span><span class="arrow">↗</span></a>)}
    </div>
  </section>
  <section class="section" id="all-tools">
    <div class="section-heading"><div><span class="eyebrow">ALL UTILITIES</span><h2>全部工具</h2></div><span class="muted" id="result-count">共 {tools.length} 个工具</span></div>
    {categories.map((category, i) => <div class="tool-group" id={`cat-${i}`} data-category={category}>
      <h3>{category}<span>{tools.filter(t => t.category === category).length}</span></h3>
      <div class="tool-grid">
        {tools.filter(t => t.category === category).map(t => <a class="tool-card" data-search={`${t.name} ${t.description} ${t.category} ${t.slug}`} href={`/tools/${t.slug}/`}><span class="tool-symbol">{t.name.slice(0,1)}</span><span class="tool-copy"><strong>{t.name}</strong><small>{t.description}</small></span><span class="card-arrow">→</span></a>)}
      </div>
    </div>)}
    <div class="empty-state" id="empty-state" hidden>没有找到匹配的工具，试试其他关键词。</div>
  </section>
  <script is:inline>
    const search = document.querySelector('#tool-search');
    const cards = [...document.querySelectorAll('#all-tools [data-search]')];
    const featuredSection = document.querySelector('#featured-tools');
    const groups = [...document.querySelectorAll('.tool-group')];
    const count = document.querySelector('#result-count');
    const empty = document.querySelector('#empty-state');
    search?.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      if (featuredSection) featuredSection.hidden = Boolean(q);
      let visible = 0;
      cards.forEach(card => {
        const show = card.dataset.search.toLowerCase().includes(q);
        card.hidden = !show;
        if (show) visible++;
      });
      groups.forEach(group => group.hidden = !group.querySelector('[data-search]:not([hidden])'));
      count.textContent = q ? `找到 ${visible} 个工具` : `共 ${cards.length} 个工具`;
      empty.hidden = visible > 0;
    });
  </script>
</BaseLayout>