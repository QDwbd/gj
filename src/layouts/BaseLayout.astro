---
const { title = '工具箱 · 实用在线工具', description = '免费、快速、注重隐私的在线工具集合。' } = Astro.props;
import '../styles/global.css';
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101827" />
    <title>{title}</title>
  </head>
  <body>
    <header class="topbar">
      <a class="brand" href="/" aria-label="工具箱首页"><span class="brand-mark">U</span><span>工具箱<span class="brand-sub">UTILITY HUB · ONLINE TOOLS</span></span></a>
      <nav><a href="/#categories">探索分类</a><a href="/#all-tools">全部工具</a><a href="/about/">关于本站</a></nav>
    </header>
    <main><slot /></main>
    <footer><div class="footer-inner"><strong>工具箱 · Utility Hub</strong><span>免费使用 · 浏览器本地处理优先 · 持续增加新工具</span><span>请勿将此站点用于违法用途。</span></div></footer>
  </body>
</html>